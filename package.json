{
  "name": "vidai",
  "private": true,
  "version": "0.2.4",
  "description": "VidAI Server: AI video edits for the whole office, in the browser",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "gen:types": "VIDAI_UPDATE_BINDINGS=1 cargo test --manifest-path src-tauri/Cargo.toml --lib bindings::tests::bindings_are_up_to_date",
    "check": "run-s format:check lint typecheck test server:typecheck server:test toolkit:test",
    "screenshots": "node scripts/screenshots.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:web": "node scripts/e2e-web.mjs",
    "bundle:mac": "node scripts/bundle-mac.mjs universal",
    "bundle:mac:arm64": "node scripts/bundle-mac.mjs arm64",
    "bundle:mac:x64": "node scripts/bundle-mac.mjs x64",
    "web": "node scripts/web.mjs",
    "web:dev": "node scripts/web.mjs --dev",
    "web:rust:fmt": "cargo fmt --manifest-path src-web/Cargo.toml --check",
    "web:rust:clippy": "cargo clippy --manifest-path src-web/Cargo.toml --all-targets -- -D warnings",
    "web:rust:test": "cargo test --manifest-path src-web/Cargo.toml",
    "web:check": "run-s web:rust:fmt web:rust:clippy web:rust:test",
    "web:bundle": "node scripts/bundle-web.mjs",
    "start": "node server/src/main.js",
    "server": "node server/src/main.js",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "toolkit:test": "python3 -B -m unittest discover -s toolkit/tests",
    "server:test": "node --test --test-reporter=dot \"server/test/**/*.test.js\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "clsx": "^2.1.1",
    "hyperframes": "0.9.80",
    "lucide-react": "^1.72.0",
    "parse5": "^8.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selfsigned": "^5.5.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
