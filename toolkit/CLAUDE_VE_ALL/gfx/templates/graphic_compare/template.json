{
  "summary": "Two columns, A against B, each with a heading and 1 to 5 points (side by side when wide, stacked when vertical)",
  "duration": 6,
  "variables": [
    {"id": "a_label", "type": "text", "required": true, "max": 40, "default": "Option A", "help": "heading of side A (accent colour)"},
    {"id": "b_label", "type": "text", "required": true, "max": 40, "default": "Option B", "help": "heading of side B (accent2 colour)"},
    {"id": "a_items", "type": "list", "required": true, "min_items": 1, "max_items": 5, "max": 70, "default": "First point|Second point|Third point", "help": "points of side A, separated by |"},
    {"id": "b_items", "type": "list", "required": true, "min_items": 1, "max_items": 5, "max": 70, "default": "First point|Second point|Third point", "help": "points of side B, separated by |"},
    {"id": "title", "type": "text", "max": 90, "default": "", "help": "heading above both sides"}
  ]
}
